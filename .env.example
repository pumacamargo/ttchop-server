PORT=3002

# OpenRouter (LLM)
OPENROUTER_API_KEY=sk-or-v1-...

# kie.ai (Veo3 / Seedance)
KIEAI_API_KEY=...

# ElevenLabs TTS
ELEVENLABS_API_KEY=sk_...

# URL pública de este servidor (para callbacks de Seedance)
SERVER_URL=http://TU_IP_VPS:3002

# Firebase Admin SDK
# Opción A: JSON inline (sin saltos de línea)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"ttchop",...}
# Opción B: ruta a un archivo JSON
# FIREBASE_SERVICE_ACCOUNT_PATH=/root/ttchop-server/firebase-service-account.json

# FTP (para subir collages)
FTP_HOST=lemonsushi.com
FTP_USER=...
FTP_PASS=...
FTP_BASE_PATH=/public_html/uploads/ttchop/collage
PUBLIC_BASE_URL=https://lemonsushi.com/uploads/ttchop/collage
