PORT=3002

# OpenRouter (LLM)
OPENROUTER_API_KEY=sk-or-v1-...

# kie.ai (Veo3 / Seedance)
KIEAI_API_KEY=...

# ElevenLabs TTS
ELEVENLABS_API_KEY=sk_...

# URL pública de este servidor (para callbacks de Seedance)
SERVER_URL=http://TU_IP_VPS:3002

# Firebase Admin SDK
# Opción A: JSON inline (sin saltos de línea)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"ttchop",...}
# Opción B: ruta a un archivo JSON
# FIREBASE_SERVICE_ACCOUNT_PATH=/root/ttchop-server/firebase-service-account.json

# Firebase Storage (para subir collages — mismo service account que Firestore)
FIREBASE_STORAGE_BUCKET=ttchop.appspot.com

# --- Multi-proyecto (OPCIONAL) ---------------------------------------------
# Si el body de la request trae projectId: "ttchop2", el servidor escribe al
# Firestore/Storage de ttchop2 en vez de al de ttchop. Sin estas variables
# (o si projectId no viene, viene vacío, o viene con un valor desconocido) el
# servidor se comporta exactamente igual que hoy: todo va a ttchop.
# FIREBASE_SERVICE_ACCOUNT_TTCHOP2={"type":"service_account","project_id":"ttchop2",...}
# FIREBASE_SERVICE_ACCOUNT_PATH_TTCHOP2=/root/ttchop-server/ttchop2-service-account.json
# FIREBASE_STORAGE_BUCKET_TTCHOP2=ttchop2.appspot.com
